# Copia este archivo como .env y ajusta los valores.
# .env NUNCA debe subirse al repositorio (ya está en .gitignore).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Si no se define, el proyecto usa SQLite (db.sqlite3) por defecto.
# Para PostgreSQL:
# DATABASE_URL=postgres://f1user:f1pass@localhost:5432/f1

CORS_ALLOWED_ORIGINS=http://localhost:3000

FASTF1_CACHE_DIR=cache/
